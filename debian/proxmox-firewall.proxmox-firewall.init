#!/bin/sh
### BEGIN INIT INFO
# Provides:          proxmox-firewall
# Required-Start:    $remote_fs $network $syslog pve-cluster pvefw-logger
# Required-Stop:     $remote_fs $network $syslog pve-cluster pvefw-logger
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Proxmox nftables firewall
# Description:       Applies the Proxmox VE firewall configuration with
#                    nftables, when the nftables firewall is enabled.
### END INIT INFO

# LSB counterpart of proxmox-firewall.service, only installed by the
# pkg.proxmox-firewall.lsbservice build (see debian/rules). Like the unit
# (Type=simple), the daemon runs in the foreground: start-stop-daemon puts it
# in the background and writes its pid file. It checks the configuration every
# few seconds and does nothing while the nftables firewall is disabled; on
# SIGTERM it removes its rules and exits.

PATH=/sbin:/bin:/usr/sbin:/usr/bin
NAME=proxmox-firewall
DESC="Proxmox nftables firewall"
DAEMON=/usr/libexec/proxmox/proxmox-firewall
PIDFILE=/run/proxmox-firewall.pid

test -x $DAEMON || exit 0

. /lib/lsb/init-functions

case "$1" in
    start)
        # starting a running daemon succeeds, as with systemctl start (LSB)
        if pidofproc -p $PIDFILE $DAEMON >/dev/null; then
            log_action_msg "$DESC is already running"
            exit 0
        fi
        log_daemon_msg "Starting $DESC" "$NAME"
        start-stop-daemon --start --quiet --background --make-pidfile \
            --pidfile $PIDFILE --exec $DAEMON -- start
        log_end_msg $?
        ;;
    stop)
        log_daemon_msg "Stopping $DESC" "$NAME"
        # it removes its rules on SIGTERM, within its 5 second update interval
        start-stop-daemon --stop --quiet --retry TERM/30/KILL/5 \
            --pidfile $PIDFILE --exec $DAEMON --remove-pidfile
        rc=$?
        # 1: wasn't running
        [ $rc -eq 1 ] && rc=0
        log_end_msg $rc
        ;;
    restart|force-reload)
        $0 stop && $0 start
        exit $?
        ;;
    status)
        status_of_proc -p $PIDFILE $DAEMON $NAME
        exit $?
        ;;
    *)
        echo "Usage: /etc/init.d/$NAME {start|stop|restart|force-reload|status}" >&2
        exit 3
        ;;
esac

exit 0
